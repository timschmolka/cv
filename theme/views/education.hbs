{{#if resume.education.length}}
<section id="education">
    <h2>Education</h2>
    {{#each resume.education}}
    <div class="item">
        <div class="item-row">
            <div><span class="item-header-title">{{studyType}}{{#if area}}, {{area}}{{/if}}</span>{{#if institution}}<span class="item-description"> · {{institution}}</span>{{/if}}</div>
            {{> item-details startDate=startDate endDate=endDate }}
        </div>
        {{#if score}}
        <ul>
            <li>
                <div class="score">
                    {{score}}
                </div>
            </li>
        </ul>
        {{/if}}
        {{#if courses.length}}
        <ul class="courses">
            {{#each courses}}
            <li>{{{.}}}</li>
            {{/each}}
        </ul>
        {{/if}}
    </div>
    {{/each}}
</section>
{{/if}}
