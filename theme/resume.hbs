<!doctype html>
<html lang="en">
    <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{#resume.basics}}
    <title>{{name}}{{#if label}} — {{label}}{{/if}}</title>
    <meta name="description" content="{{name}}{{#if label}} — {{label}}{{/if}}">
    <meta property="og:type" content="profile">
    <meta property="og:title" content="{{name}}">
    {{#if label}}
    <meta property="og:description" content="{{label}}">
    {{/if}}
    {{/resume.basics}}

    <style>
    {{{css}}}
    </style>

    </head>
    <body>

    <div id="resume">
        {{> basics }}
        {{> work }}
        {{> skills }}
        {{> volunteer }}
        {{> education }}
        {{> awards }}
    </div>
    </body>
</html>
